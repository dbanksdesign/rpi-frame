{
  "name": "rpi-photo-frame",
  "version": "1.0.0",
  "description": "Digital photo frame web application for Raspberry Pi",
  "main": "dist/server/index.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "vitest run",
    "test:updater": "bash pi/updater/test/updater.test.sh",
    "test:release": "bash scripts/make-release.test.sh",
    "test:install": "bash pi/test/install-dry-run.test.sh",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --watch server --ext ts --exec tsx server/index.ts",
    "dev:client": "vite",
    "dev:display": "node display-client.js",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "start": "NODE_ENV=production node dist/server/index.js",
    "start:display": "node display-client.js",
    "preview": "vite preview",
    "install:services": "./install-display.sh",
    "uninstall:services": "./uninstall.sh",
    "optimize:uploads": "node scripts/optimize-uploads.js"
  },
  "keywords": [
    "raspberry-pi",
    "photo-frame",
    "slideshow"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@tabler/icons-react": "^3.35.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "qrcode.react": "^4.2.0",
    "react-router-dom": "^6.20.1",
    "sharp": "^0.35.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/react-router-dom": "^5.3.3",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  }
}
