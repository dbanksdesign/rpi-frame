[Unit]
Description=Photo frame server (slideshow, admin page, setup and updates)
# Ordering only (no Wants=network-online.target): a frame with no WiFi must not
# wait for NetworkManager-wait-online before it can show the setup screen.
After=network-online.target NetworkManager.service tailscaled.service
# Releases, photos and metadata all live on the data partition.
RequiresMountsFor=/data

[Service]
User=frame
Group=frame
WorkingDirectory=/data/current
# Re-assert `tailscale set --operator=frame` (a tailscaled pref that a handoff
# or `tailscale logout` can clear) so the server may run `tailscale up`.
# '+' runs it as root despite User=frame; '-' means a failure never blocks the
# start (the helper also always exits 0).
ExecStartPre=+-/usr/local/lib/photo-frame/tailscale-operator.sh
ExecStart=/usr/bin/node /data/current/dist/server/index.js
Environment=NODE_ENV=production PORT=3000 FRAME_DATA_DIR=/data
# Display Off/On runs `DISPLAY=:0 xset ...`, which needs the X cookie LightDM
# writes for the kiosk session (frame's autologin).
Environment=XAUTHORITY=/home/frame/.Xauthority
# The captive portal listens on port 80 while the setup hotspot is up.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3
# Hardening kept deliberately modest:
# - NoNewPrivileges is NOT set: the update button runs
#   `sudo -n systemd-run ... /usr/local/sbin/frame-update <tag>`, and sudo is
#   setuid, which NoNewPrivileges would block.
# - ProtectHome=read-only: the server writes nothing under /home (its code and
#   data are under /data), but xset must read /home/frame/.Xauthority, so /home
#   is read-only rather than hidden.
# - PrivateTmp: upload scratch files stay private to the service. The updater
#   runs as its own transient unit, so it is not affected.
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
